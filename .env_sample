# 复制为 .env 后填写：cp .env_sample .env && chmod 600 .env
# .env 已在 .gitignore 中，不会被提交；不要把真实密钥写进代码或本文件。

# ---- 必填 ----
# DeepSeek API key（https://platform.deepseek.com）
DEEPSEEK_API_KEY=sk-xxxxxxxx

# ---- 网页登录（对外开放时必填，HTTP Basic Auth）----
APP_USER=admin
APP_PASSWORD=请设置强密码

# ---- 对外接口 /api/v1（给其他网站接入，见 docs/API.md）----
# 接入方与 Key，格式 站点A:key1,站点B:key2；生成：python3 -c "import secrets;print('sk_live_'+secrets.token_urlsafe(24))"
# API_KEYS=
# Webhook 回调签名密钥，提供给接入方验签
# WEBHOOK_SECRET=
# 对外地址（HTTPS/反向代理部署时必填）：接口返回的文件链接、接入文档里的示例地址都用它
# PUBLIC_BASE_URL=https://videodata.sligenai.cn
# 文件签名链接有效期（秒，默认 7 天）；签名密钥不填会自动生成在 runs/.signing_secret
# FILE_URL_TTL=604800
# SIGNING_SECRET=

# ---- 可选：模型 ----
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# VISION_MODEL=deepseek-flash      # 识图，需支持图片输入
# TEXT_MODEL=deepseek-flash        # 打分重排

# ---- 可选：平台登录态 ----
# 已登录 B 站的 cookie（浏览器开发者工具复制，至少含 SESSDATA），可显著降低搜索风控
# BILIBILI_COOKIE=SESSDATA=xxx; buvid3=xxx
# 抖音下载需要 cookies.txt（Netscape 格式）的绝对路径
# DOUYIN_COOKIES_FILE=/path/to/douyin_cookies.txt   # Docker 部署填 /app/secrets/douyin_cookies.txt

# ---- 可选：新增数据源 ----
# YouTube Data API v3 key（Google Cloud Console 开启 YouTube Data API v3）
# 配了之后搜索走官方接口（无风控、字段全）；不配或配额用完自动回退 yt-dlp
# YOUTUBE_API_KEY=AIza...
# YOUTUBE_DAILY_QUOTA=10000     # 每天配额单位；search.list 每次 100，videos.list 每次 1
# YOUTUBE_CACHE_TTL=21600       # 同一关键词结果缓存秒数，默认 6 小时
#
# Meta 广告资料库 access token（需完成 Meta 身份验证的开发者账号）
# 不配也能用：会渲染公开广告库页面取在投视频，只是慢一些（约 15 秒/关键词）
# META_AD_LIBRARY_TOKEN=
# META_AD_LIBRARY_VERSION=v23.0
# META_AD_LIBRARY_COUNTRIES=US,GB,DE,FR,JP
#
# Google 广告透明度中心不需要 key，但必须能访问 Google（配置 PROXY_URL 即可）

# ---- 可选：出口代理 ----
# 搜索和解析用的出口；代码里只有 youtube/tiktok/bilibili/gads/meta 走代理
# PROXY_URL=socks5h://127.0.0.1:1080
# 下载可以单独走带宽更好的出口（不填则与 PROXY_URL 相同）
# DOWNLOAD_PROXY_URL=socks5h://127.0.0.1:1082
# 多个出口按顺序探测，坏了自动换：主用带宽好的中继，备用直连干净 IP
# PROXY_URLS=socks5h://127.0.0.1:1080,socks5h://127.0.0.1:1081
# DOWNLOAD_PROXY_URLS=socks5h://127.0.0.1:1080,socks5h://127.0.0.1:1081
# 按平台指定出口：Google/Meta 用另一台 IP，避免和 YouTube 抢风控额度
# PLATFORM_PROXY=gads=socks5h://127.0.0.1:1083,meta=socks5h://127.0.0.1:1083
# Google 广告透明度中心限流紧，可配多个出口轮换
# GADS_PROXY_URLS=socks5h://127.0.0.1:1083,socks5h://127.0.0.1:1080

# ---- 可选：运行参数 ----
# PORT=8770               # 服务端口
# HOST=127.0.0.1          # ./start.sh 监听地址；前面有 nginx/HTTPS 时设 127.0.0.1，关闭 IP:端口 直连
# BIND_IP=0.0.0.0         # docker compose 监听地址；前面有 nginx/HTTPS 时设 127.0.0.1，关闭 IP:端口 直连
# SEARCH_WORKERS=2        # 同时执行的检索任务数，其余排队
# RUNS_DIR=./runs         # 非 Docker 部署时的结果目录（Docker 内固定为 /app/runs）

# 时区（可选）：页面和接口里的时间都按这个时区显示，默认东八区
# APP_TZ=CST-8
