# 复制为 .env 后填写：cp .env_sample .env && chmod 600 .env
# .env 已在 .gitignore 中，不会被提交；不要把真实密钥写进代码或本文件。

# ---- 必填 ----
# DeepSeek API key（https://platform.deepseek.com）
DEEPSEEK_API_KEY=sk-xxxxxxxx

# ---- 网页登录（对外开放时必填，HTTP Basic Auth）----
APP_USER=admin
APP_PASSWORD=请设置强密码

# ---- 对外接口 /api/v1（给其他网站接入，见 docs/API.md）----
# 接入方与 Key，格式 站点A:key1,站点B:key2；生成：python3 -c "import secrets;print('sk_live_'+secrets.token_urlsafe(24))"
# API_KEYS=
# Webhook 回调签名密钥，提供给接入方验签
# WEBHOOK_SECRET=
# 对外地址（HTTPS/反向代理部署时必填）：接口返回的文件链接、接入文档里的示例地址都用它
# PUBLIC_BASE_URL=https://videodata.sligenai.cn
# 文件签名链接有效期（秒，默认 7 天）；签名密钥不填会自动生成在 runs/.signing_secret
# FILE_URL_TTL=604800
# SIGNING_SECRET=

# ---- 可选：模型 ----
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# VISION_MODEL=deepseek-flash      # 识图，需支持图片输入
# TEXT_MODEL=deepseek-flash        # 打分重排

# ---- 可选：平台登录态 ----
# 已登录 B 站的 cookie（浏览器开发者工具复制，至少含 SESSDATA），可显著降低搜索风控
# BILIBILI_COOKIE=SESSDATA=xxx; buvid3=xxx
# 抖音下载需要 cookies.txt（Netscape 格式）的绝对路径
# DOUYIN_COOKIES_FILE=/path/to/douyin_cookies.txt   # Docker 部署填 /app/secrets/douyin_cookies.txt

# ---- 可选：运行参数 ----
# PORT=8770               # 服务端口
# BIND_IP=0.0.0.0         # docker compose 监听地址；前面有 nginx/HTTPS 时设 127.0.0.1，关闭 IP:端口 直连
# SEARCH_WORKERS=2        # 同时执行的检索任务数，其余排队
# RUNS_DIR=./runs         # 非 Docker 部署时的结果目录（Docker 内固定为 /app/runs）
